<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.CustomerFormController"
            prefWidth="500" prefHeight="350">

    <top>
        <Label text="Manage Customers"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-padding: 15;"/>
    </top>

    <center>
        <VBox spacing="12" alignment="CENTER" style="-fx-padding: 20;">

            <TableView fx:id="tableCustomers" prefWidth="700" prefHeight="330">
                <columns>
                    <TableColumn fx:id="colAfm"       text="AFM"         prefWidth="120"/>
                    <TableColumn fx:id="colFullName"  text="Full Name"   prefWidth="180"/>
                    <TableColumn fx:id="colPhone"     text="Phone"       prefWidth="150"/>
                    <TableColumn fx:id="colEmail"     text="Email"       prefWidth="250"/>
                </columns>
            </TableView>

            <!-- Input fields -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="txtAfm"       promptText="AFM"          prefWidth="120"/>
                <TextField fx:id="txtFullName"  promptText="Full Name"    prefWidth="180"/>
                <TextField fx:id="txtPhone"     promptText="Phone Number" prefWidth="150"/>
                <TextField fx:id="txtEmail"     promptText="Email"        prefWidth="200"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER">
                <Button text="Add"    prefWidth="100" onAction="#handleAdd"/>
                <Button text="Update" prefWidth="100" onAction="#handleUpdate"/>
                <Button text="Delete" prefWidth="100" onAction="#handleDelete"/>
            </HBox>

            <Label fx:id="lblStatus" style="-fx-font-size:14; -fx-padding:8;"/>

        </VBox>
    </center>

    <bottom>
        <Button text="Back"
                prefWidth="120"
                style="-fx-padding:10; -fx-font-size:14;"
                onAction="#goBack"
                BorderPane.alignment="CENTER"/>
    </bottom>
</BorderPane>
