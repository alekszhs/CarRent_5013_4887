<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.ReturnRentalController"
      spacing="15"
      alignment="CENTER_LEFT"
      style="-fx-padding:20;"
      prefWidth="500" prefHeight="350">

    <Label text="Return Rental" style="-fx-font-size:22; -fx-font-weight:bold"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Rental ID:"/>
        <TextField fx:id="txtRentalId" prefWidth="200"/>
        <Button text="Return" onAction="#handleReturn"/>
    </HBox>

    <Separator/>

    <Label text="Active rentals for customer or car:"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="AFM:"/>
        <TextField fx:id="txtAfm" prefWidth="200"/>

        <Label text="Plate:"/>
        <TextField fx:id="txtPlate" prefWidth="150"/>

        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <TableView fx:id="tableActive" prefHeight="380">
        <columns>
            <TableColumn fx:id="colId" text="Rental ID" prefWidth="100"/>
            <TableColumn fx:id="colPlate" text="Car Plate" prefWidth="120"/>
            <TableColumn fx:id="colAfm" text="AFM" prefWidth="130"/>
            <TableColumn fx:id="colStart" text="From" prefWidth="150"/>
            <TableColumn fx:id="colEnd" text="To" prefWidth="150"/>
        </columns>
    </TableView>

    <Label fx:id="lblStatus" style="-fx-font-size:14;"/>

    <!-- Κουμπί Back -->
    <Button text="Back" onAction="#goBack"/>

</VBox>