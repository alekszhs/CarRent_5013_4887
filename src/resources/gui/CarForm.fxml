<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.CarFormController"
            prefWidth="900" prefHeight="600">

    <!-- Title -->
    <top>
        <Label text="Manage Cars"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-padding: 15;" />
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15;">

            <!-- Table -->
            <TableView fx:id="tableCars" prefHeight="300" prefWidth="850">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"        prefWidth="70"/>
                    <TableColumn fx:id="colPlate"   text="Plate"     prefWidth="120"/>
                    <TableColumn fx:id="colBrand"   text="Brand"     prefWidth="120"/>
                    <TableColumn fx:id="colModel"   text="Model"     prefWidth="120"/>
                    <TableColumn fx:id="colYear"    text="Year"      prefWidth="80"/>
                    <TableColumn fx:id="colColor"   text="Color"     prefWidth="100"/>
                    <TableColumn fx:id="colStatus"  text="Status"    prefWidth="100"/>
                </columns>
            </TableView>

            <!-- First Row of Inputs -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="txtId"      promptText="ID"    prefWidth="80"/>
                <TextField fx:id="txtPlate"   promptText="Plate" prefWidth="120"/>
                <TextField fx:id="txtBrand"   promptText="Brand" prefWidth="120"/>
                <TextField fx:id="txtModel"   promptText="Model" prefWidth="120"/>
            </HBox>

            <!-- Second Row of Inputs -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="txtType"    promptText="Type"  prefWidth="120"/>
                <TextField fx:id="txtYear"    promptText="Year"  prefWidth="80"/>
                <TextField fx:id="txtColor"   promptText="Color" prefWidth="100"/>
                <ComboBox fx:id="cmbStatus"   promptText="Status" prefWidth="120"/>
            </HBox>

            <!-- Action Buttons -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="Add"    prefWidth="90" onAction="#handleAdd"/>
                <Button text="Update" prefWidth="90" onAction="#handleUpdate"/>
                <Button text="Delete" prefWidth="90" onAction="#handleDelete"/>
                <Button text="Search" prefWidth="90" onAction="#handleSearch"/>
                <Button text="Clear"  prefWidth="90" onAction="#handleClear"/>
            </HBox>

            <!-- Status Label -->
            <Label fx:id="lblStatus"
                   style="-fx-font-size: 14; -fx-padding: 5; -fx-text-fill: #ff5555;"/>
        </VBox>
    </center>

    <!-- Back Button -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 10;">
            <Button text="Back"
                    prefWidth="120"
                    style="-fx-font-size: 14;"
                    onAction="#handleGoBack"/>
        </HBox>
    </bottom>

</BorderPane>