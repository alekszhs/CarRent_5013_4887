<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.CustomerRentalHistoryController"
            prefWidth="900" prefHeight="600">

    <!-- Top Section -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Rental History"
                   style="-fx-font-size: 22; -fx-font-weight: bold;" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Customer AFM:"/>
                <TextField fx:id="txtAfm" prefWidth="150"/>

                <Label text="Car Plate:"/>
                <TextField fx:id="txtPlate" prefWidth="120"/>

                <Button text="Search" onAction="#handleSearch"/>
                <Button text="Clear"  onAction="#handleClear"/>
            </HBox>
        </VBox>
    </top>

    <!-- Table -->
    <center>
        <TableView fx:id="tableResults" prefWidth="850" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId"     text="Rental ID" prefWidth="90"/>
                <TableColumn fx:id="colPlate"  text="Car Plate" prefWidth="100"/>
                <TableColumn fx:id="colAfm"    text="AFM"       prefWidth="110"/>
                <TableColumn fx:id="colStart"  text="From"      prefWidth="130"/>
                <TableColumn fx:id="colEnd"    text="To"        prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="Status"    prefWidth="90"/>
            </columns>
        </TableView>
    </center>

    <!-- Bottom Section -->
    <bottom>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Label fx:id="lblStatus"
                   style="-fx-font-size: 14; -fx-text-fill: #ff5555;" />

            <Button text="Back"
                    prefWidth="120"
                    style="-fx-font-size: 14;"
                    onAction="#handleGoBack"/>
        </VBox>
    </bottom>

</BorderPane>