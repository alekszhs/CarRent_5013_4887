<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.MainMenuController"
            prefWidth="500" prefHeight="450">

    <!-- Title -->
    <top>
        <Label text="Car Rental Management System"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-padding: 15;" />
    </top>

    <!-- Menu Buttons -->
    <center>
        <VBox spacing="18" alignment="CENTER">

            <Button text="Manage Cars"
                    prefWidth="220"
                    onAction="#handleOpenCars"/>

            <Button text="Manage Customers"
                    prefWidth="220"
                    onAction="#handleOpenCustomers"/>

            <Button text="Manage Employees"
                    prefWidth="220"
                    onAction="#handleOpenEmployees"/>

            <Button text="New Rental"
                    prefWidth="220"
                    onAction="#handleOpenRentalForm"/>

            <Button text="Return Rental"
                    prefWidth="220"
                    onAction="#handleOpenReturnRental"/>

            <Button text="Rental History"
                    prefWidth="220"
                    onAction="#handleOpenHistory"/>

            <Button text="Logout"
                    prefWidth="220"
                    onAction="#handleLogout"/>

        </VBox>
    </center>

</BorderPane>